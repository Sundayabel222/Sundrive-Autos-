# Copy to `.env` and fill in. Prisma's CLI and the Next.js server both read this file.

# ---- Database -------------------------------------------------------------
# SQLite (default, zero setup). Move to Postgres by changing the provider in
# prisma/schema.prisma, swapping the adapter in src/lib/prisma.ts, and pointing
# this at your connection string.
DATABASE_URL="file:./prisma/dev.db"

# ---- Auth -----------------------------------------------------------------
# Signs the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# ---- Seed admin account ---------------------------------------------------
SEED_ADMIN_EMAIL="admin@sundriveautos.com"
SEED_ADMIN_PASSWORD="change-me-before-you-deploy"

# ---- Public site URL (SEO metadata, sitemap, robots) ----------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Optional integrations (see README) -----------------------------------
# Lead alerts. Leave blank to log to the server console instead.
# RESEND_API_KEY=""
# LEAD_NOTIFICATION_EMAIL=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_ALERT_TO=""

# ---- Optional: Cloudinary for vehicle image uploads ------------------------
# Without these, admin image uploads fall back to local /public/uploads.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
